{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["*.ts", "*.tsx", "e2e/**/*.ts"]
}
