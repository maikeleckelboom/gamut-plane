{
  "name": "@gamut-plane/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Private shared instrument anatomy, stylesheet, glyph geometry, and framework-neutral interaction policies.",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json && node scripts/copyStyle.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gamut-plane/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "jsdom": "28.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
