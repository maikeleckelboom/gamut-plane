{
  "name": "@gamut-plane/workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @gamut-plane/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @gamut-plane/web test:e2e",
    "lint": "pnpm -r --if-present lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:gamut-tables": "pnpm --filter @gamut-plane/web check:gamut-tables"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
