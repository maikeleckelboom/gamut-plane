{
  "name": "@gamut-plane/workspace",
  "private": true,
  "description": "Vue and React color-plane instruments with authored ColorValue state, sampled guides, and exact gamut status.",
  "license": "MIT",
  "author": "Maikel Eckelboom",
  "repository": {
    "type": "git",
    "url": "https://github.com/maikeleckelboom/gamut-plane.git"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @gamut-plane/web dev",
    "build": "pnpm -r --if-present build",
    "check:build": "pnpm --filter @gamut-plane/web check:build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @gamut-plane/web test:e2e",
    "test:production": "pnpm --filter @gamut-plane/web test:production",
    "lint": "oxlint -c ./.oxlintrc.json --disable-nested-config .",
    "format": "oxfmt -c ./.oxfmtrc.json --disable-nested-config .",
    "format:check": "oxfmt -c ./.oxfmtrc.json --disable-nested-config --check .",
    "check:gamut-tables": "pnpm --filter @gamut-plane/render check:gamut-tables",
    "generate:release-assets": "pnpm --filter @gamut-plane/web generate:release-assets",
    "preview:production": "pnpm --filter @gamut-plane/web preview:production",
    "build:packages": "pnpm --filter @gamut-plane/core --filter @gamut-plane/render --filter @gamut-plane/vue --filter @gamut-plane/react build",
    "test:package": "pnpm build:packages && pnpm --filter @gamut-plane/vue test:package",
    "test:nuxt": "pnpm build:packages && pnpm --filter @gamut-plane/vue test:nuxt",
    "test:next": "pnpm build:packages && pnpm --filter @gamut-plane/react test:package",
    "test:react-vite": "pnpm build:packages && pnpm --filter @gamut-plane/react test:vite"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
