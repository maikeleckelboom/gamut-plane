    "@lucide/vue": "1.23.0",
    "@tailwindcss/vite": "4.3.2",
    "@vueuse/core": "14.3.0",
    "clsx": "2.1.1",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
