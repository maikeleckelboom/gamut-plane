{
  "name": "@chromavert/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/prepareStaticBuild.mjs",
    "check:picker-tables": "node scripts/generatePickerTables.mjs --check",
