    "vue": "3.5.39"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "28.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
